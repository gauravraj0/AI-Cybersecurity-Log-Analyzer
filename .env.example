# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# Local dev (default): SQLite file
# DATABASE_URL=sqlite:///./sentinel.db
# Docker Compose / production: PostgreSQL
# DATABASE_URL=postgresql+psycopg://sentinel:sentinel@db:5432/sentinel

# --- Generative AI (optional) ---
# If neither key is set, the built-in heuristic analyst engine writes incident summaries.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Detection tuning (optional) ---
# BRUTE_FORCE_THRESHOLD=5
# BRUTE_FORCE_WINDOW_MIN=5
# PORTSCAN_THRESHOLD=12
# DOS_RPM_THRESHOLD=60
